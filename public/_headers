# Response headers for the files of https://playdacapo.com (Cloudflare Workers static assets; not
# served itself). Vite names the files under /assets/ by their content, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The offline worker (docs/OFFLINE.md) keeps its name from build to build: always asked for anew,
# so a fix to it, or its withdrawal, reaches a browser at its next visit.
/sw.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
