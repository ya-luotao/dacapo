#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
  printf '%s\n' '[orb resume] Node.js and pnpm must be installed by .agents/setup.' >&2
  exit 1
fi

node -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  if (major < 22 || (major === 22 && minor < 13)) {
    console.error(`Node.js ${process.versions.node} is too old; dacapo requires Node.js 22.13 or newer.`);
    process.exit(1);
  }
'

expected_pnpm="$(node -p "require('./package.json').packageManager.split('@')[1]")"
actual_pnpm="$(pnpm --version)"
if [[ "$actual_pnpm" != "$expected_pnpm" ]]; then
  printf '[orb resume] Expected pnpm %s, found %s. Run .agents/setup to repair the orb.\n' \
    "$expected_pnpm" "$actual_pnpm" >&2
  exit 1
fi

printf '[orb resume] Node.js %s, pnpm %s\n' "$(node --version)" "$actual_pnpm"
