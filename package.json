{
  "name": "dacapo",
  "private": true,
  "version": "0.2.0",
  "description": "Free, open-source piano practice with a MIDI keyboard: sight-reading on a real grand staff, scales measured for evenness, real pieces in wait and rhythm mode, and a metronome, all in the browser.",
  "keywords": [
    "piano",
    "sight-reading",
    "music-education",
    "grand-staff",
    "midi",
    "web-midi",
    "music-notation",
    "musicxml",
    "flashcards",
    "practice",
    "metronome",
    "piano-scales",
    "piano-practice",
    "react",
    "typescript",
    "pwa"
  ],
  "homepage": "https://playdacapo.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ya-luotao/dacapo.git"
  },
  "bugs": {
    "url": "https://github.com/ya-luotao/dacapo/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:empty": "vite --config vite.scenarios.config.ts --mode empty",
    "dev:progress": "vite --config vite.scenarios.config.ts --mode progress",
    "dev:piece": "vite --config vite.scenarios.config.ts --mode piece",
    "build": "pnpm typecheck && pnpm build:bundle",
    "build:bundle": "vite build",
    "build:site": "VITE_SYNC_ENDPOINT=https://api.playdacapo.com SITE_URL=https://playdacapo.com pnpm build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit --incremental",
    "typecheck:watch": "pnpm typecheck --watch",
    "lint": "eslint .",
    "lint:fast": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:regression": "vitest run --config vitest.regression.config.ts",
    "test:smoke": "playwright test",
    "test:watch": "vitest --watch",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:bundle"
  },
  "dependencies": {
    "@vexflow-fonts/bravura": "^1.0.2",
    "fflate": "0.8.3",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "verovio": "6.3.0",
    "vexflow": "^5.0.0",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "30.1.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.1"
  }
}
