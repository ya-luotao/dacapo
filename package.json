{
  "name": "dacapo",
  "private": true,
  "version": "0.1.0",
  "description": "Learn to read the grand staff and find the key fast with a MIDI keyboard: sight-reading flashcards, a weakness heatmap and real pieces in wait and rhythm mode, all in the browser.",
  "keywords": [
    "piano",
    "sight-reading",
    "music-education",
    "grand-staff",
    "midi",
    "web-midi",
    "music-notation",
    "musicxml",
    "flashcards",
    "practice",
    "metronome",
    "react",
    "typescript",
    "pwa"
  ],
  "homepage": "https://ya-luotao.github.io/dacapo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ya-luotao/dacapo.git"
  },
  "bugs": {
    "url": "https://github.com/ya-luotao/dacapo/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@vexflow-fonts/bravura": "^1.0.2",
    "fflate": "0.8.3",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "verovio": "6.3.0",
    "vexflow": "^5.0.0",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "30.1.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
