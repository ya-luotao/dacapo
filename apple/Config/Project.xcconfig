// Project-wide settings shared by every configuration. Every build setting lives in these text
// files, never in project.pbxproj (scripts/check-pbxproj.sh enforces it), so changes are
// reviewable as plain diffs.

SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SUPPORTS_MACCATALYST = NO
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0

SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
// scripts/embed-web.sh writes outside declared outputs (DERIVED_FILE_DIR/web, the bundle's web/).
ENABLE_USER_SCRIPT_SANDBOXING = NO
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
MTL_ENABLE_DEBUG_INFO = NO
